{
  "purpose": "以历史时间发展逻辑组织设计史，而非按照教材章节排列",
  "principle": "先看时代变化，再理解设计运动、人物、作品与影响",
  "timeline_groups": [
    {
      "period": "1750-1850",
      "theme": "工业革命与现代设计萌芽",
      "importance": "red",
      "nodes": [
        {
          "year": "1750",
          "event": "工业革命",
          "logic": "机械生产改变传统手工业体系，为现代设计产生提供社会基础"
        },
        {
          "year": "1851",
          "event": "水晶宫国际工业博览会",
          "logic": "工业技术与审美矛盾显现，引发设计改革思考"
        }
      ]
    },
    {
      "period": "1850-1910",
      "theme": "设计改革运动",
      "importance": "red",
      "nodes": [
        {
          "year": "1880",
          "event": "工艺美术运动",
          "logic": "反思工业化，强调手工艺价值与生活艺术化"
        },
        {
          "year": "1890",
          "event": "新艺术运动",
          "logic": "探索新的形式语言，摆脱历史样式束缚"
        }
      ]
    },
    {
      "period": "1900-1930",
      "theme": "现代设计体系形成",
      "importance": "red",
      "nodes": [
        {
          "year": "1907",
          "event": "德意志制造联盟",
          "logic": "推动艺术、工业与标准化结合"
        },
        {
          "year": "1919",
          "event": "包豪斯成立",
          "logic": "建立现代设计教育体系，提出艺术与技术统一"
        }
      ]
    },
    {
      "period": "1930-1970",
      "theme": "现代主义扩散与多元发展",
      "importance": "yellow",
      "nodes": [
        {
          "year": "1950",
          "event": "国际主义设计",
          "logic": "功能主义和理性主义成为主流"
        },
        {
          "year": "1953",
          "event": "乌尔姆设计学院",
          "logic": "强化科学、系统方法在设计中的作用"
        }
      ]
    },
    {
      "period": "1970-至今",
      "theme": "后现代与当代设计转向",
      "importance": "yellow",
      "nodes": [
        {
          "year": "1980",
          "event": "后现代主义设计",
          "logic": "反思现代主义单一理性，强调文化和符号"
        },
        {
          "year": "2000",
          "event": "数字化与可持续设计",
          "logic": "设计从产品走向系统、服务和社会问题解决"
        }
      ]
    }
  ]
}
